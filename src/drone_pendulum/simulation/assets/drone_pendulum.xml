
<mujoco model="drone_double_pendulum">

    <compiler angle="radian" autolimits="true" meshdir="meshes"/>

    <option
        timestep="0.002"
        gravity="0 0 -9.81"
        integrator="implicitfast"
    />

    <visual>
        <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3"/>
    </visual>

    <include file="cad_meshes.xml"/>

    <worldbody>

        <light pos="0 0 5" dir="0 0 -1"/>
        <geom
            name="ground"
            type="plane"
            size="5 5 0.1"
            rgba="0.3 0.3 0.3 1"
        />

        <!-- Quadrotor -->
        <body name="drone" pos="0 0 2">

            <freejoint name="drone_free"/>

            <include file="cad_airframe.xml"/>
            <include file="cad_pendulum.xml"/>
        </body>
    </worldbody>
</mujoco>
