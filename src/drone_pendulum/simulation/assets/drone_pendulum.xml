
<mujoco model="drone_double_pendulum">

    <compiler angle="radian" autolimits="true"/>

    <option
        timestep="0.002"
        gravity="0 0 -9.81"
        integrator="implicitfast"
    />

    <visual>
        <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3"/>
    </visual>

    <worldbody>

        <light pos="0 0 5" dir="0 0 -1"/>
        <geom
            name="ground"
            type="plane"
            size="5 5 0.1"
            rgba="0.3 0.3 0.3 1"
        />

        <!-- Quadrotor -->
        <body name="drone" pos="0 0 2">

            <freejoint name="drone_free"/>

            <geom
                name="drone_body"
                type="box"
                size="0.18 0.18 0.06"
                mass="1.0"
                rgba="0.2 0.4 0.8 1"
            />

            <!-- Upper pendulum link -->
            <body name="link1" pos="0 0 -0.06">

                <joint
                    name="joint1"
                    type="hinge"
                    axis="1 0 0"
                    limited="false"
                    damping="0.02"
                />

                <geom
                    name="link1_rod"
                    type="capsule"
                    fromto="0 0 0 0 0 -0.5"
                    size="0.015"
                    mass="0.03"
                    rgba="0.7 0.7 0.7 1"
                />

                <geom
                    name="link1_mass"
                    type="sphere"
                    pos="0 0 -0.5"
                    size="0.06"
                    mass="0.12"
                    rgba="0.9 0.3 0.2 1"
                />

                <!-- Lower pendulum link -->
                <body name="link2" pos="0 0 -0.5">

                    <joint
                        name="joint2"
                        type="hinge"
                        axis="1 0 0"
                        limited="false"
                        damping="0.02"
                    />

                    <geom
                        name="link2_rod"
                        type="capsule"
                        fromto="0 0 0 0 0 -0.5"
                        size="0.012"
                        mass="0.02"
                        rgba="0.7 0.7 0.7 1"
                    />

                    <geom
                        name="link2_mass"
                        type="sphere"
                        pos="0 0 -0.5"
                        size="0.05"
                        mass="0.08"
                        rgba="0.9 0.3 0.2 1"
                    />

                </body>
            </body>
        </body>
    </worldbody>
</mujoco>
