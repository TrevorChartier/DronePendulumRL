<launch>
  <arg name="model" default="$(find drone_pendulum_description)/urdf/drone_pendulum.urdf" />
  <param name="robot_description" textfile="$(arg model)" />
  <include
    file="$(find gazebo_ros)/launch/empty_world.launch" />
  <node
    name="spawn_model"
    pkg="gazebo_ros"
    type="spawn_model"
    args="-param robot_description -urdf -model drone_pendulum"
    output="screen" />
</launch>
